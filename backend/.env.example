# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Matches the `db` service in docker-compose.yml (exposed on host port 5433)
DATABASE_URL=postgresql://fnb:fnb_password@localhost:5433/fnb_hq?schema=public
DB_POOL_MAX=10
DB_SSL=false

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h

# --- CORS -----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- Demo data --------------------------------------------------------------
# Seed demo outlets/menu/users/sales on start-up when the database is empty
SEED_DEMO_DATA=true
