# Optional overrides for `docker compose up`. Copy to `.env` next to docker-compose.yml.
POSTGRES_USER=fnb
POSTGRES_PASSWORD=fnb_password
POSTGRES_DB=fnb_hq
DB_HOST_PORT=5433
WEB_HOST_PORT=8080

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=local-docker-secret-change-me-please-0123456789
JWT_EXPIRES_IN=8h
LOG_LEVEL=info
SEED_DEMO_DATA=true
